# =========================================================
#  ЛИЧНЫЕ ДАННЫЕ — никогда не коммитить
# =========================================================

# вся папка с данными: data.json и backups/
data/

# на случай, если данные окажутся в корне или рядом с кодом
data.json
data.json.*
*.tmp
backups/
backup*/
!backups/.gitkeep
*.bak
*.backup
*_backup_*
snapshot*/
data_*.json
team-planner-*.json

# экспорты / выгрузки
export*/
exports/
*.csv
*.xlsx
*.xls

# =========================================================
#  СЕКРЕТЫ И КОНФИГИ ОКРУЖЕНИЯ
# =========================================================
.env
.env.*
!.env.example
*.key
*.pem
secrets.json
credentials.json
config.local.*
*.local.json

# =========================================================
#  СИСТЕМНОЕ И РЕДАКТОРЫ
# =========================================================
Thumbs.db
desktop.ini
.DS_Store
*.log
npm-debug.log*
.vscode/
.idea/
*.swp
*~

# ярлык «Планировщик» создаётся при первом запуске и хранит
# абсолютный путь этого компьютера — в git ему нельзя
*.lnk
