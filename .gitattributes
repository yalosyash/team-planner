# =========================================================
#  КОДИРОВКИ И ПЕРЕВОДЫ СТРОК
# =========================================================

# Текст в репозитории — всегда UTF-8, без BOM.
# Переводы строк: в объектах git — LF, в рабочей папке — CRLF (Windows),
# как и было при core.autocrlf=true. Атрибуты задаём точечно, чтобы
# не перенормализовать весь репозиторий.

# Shell-скрипты и хуки требуют LF, иначе bash падает на "\r".
*.sh text eol=lf
.githooks/* text eol=lf

# .bat читает cmd.exe: только CRLF, плюс он в UTF-8 (нужен chcp 65001 внутри).
*.bat text eol=crlf

# .vbs Windows Script Host читает в ANSI-кодировке, поэтому эти файлы
# держим в ASCII/UTF-8 без кириллицы — git не должен их трогать.
*.vbs text eol=crlf

# Бинарные файлы — не конвертировать и не диффать как текст.
*.ico binary
*.png binary
*.jpg binary
*.gif binary
*.zip binary
*.pdf binary
